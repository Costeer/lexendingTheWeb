{
  "name": "lexending-the-web",
  "version": "0.5.0",
  "private": true,
  "description": "A Chrome and Firefox extension that makes the web easier to read with Lexend.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ui-tests": "node scripts/build.mjs --ui-tests",
    "check": "node scripts/check.mjs",
    "lint:firefox": "addons-linter dist/firefox --warnings-as-errors",
    "test": "node scripts/test.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:ui": "npm run build:ui-tests && playwright test",
    "test:ui:update": "npm run build:ui-tests && playwright test --update-snapshots",
    "test:packages": "node scripts/test-packages.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify:chrome": "npm test && npm run check && npm run package && npm run test:packages",
    "verify:firefox": "npm test && npm run check && npm run package && npm run test:packages && npm run lint:firefox",
    "version": "node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "addons-linter": "^10.13.0",
    "fflate": "^0.8.3",
    "playwright": "1.63.0",
    "selenium-webdriver": "^4.50.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
