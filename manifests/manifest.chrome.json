{
  "manifest_version": 3,
  "name": "Lexend the Web",
  "version": "0.1.0",
  "description": "Make websites easier to read with Lexend.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Lexend the Web",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/lexend-latin-wght-normal.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}

