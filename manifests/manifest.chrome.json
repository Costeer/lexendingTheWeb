{
  "manifest_version": 3,
  "name": "Lexend the Web",
  "version": "0.3.0",
  "description": "Make websites easier to read with Lexend.",
  "homepage_url": "https://github.com/Costeer/lexendingTheWeb",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Lexend the Web",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-current-site": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle Lexend on the current website"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/lexend-latin-wght-normal.woff2",
        "assets/fonts/lexend-latin-ext-wght-normal.woff2",
        "assets/fonts/lexend-vietnamese-wght-normal.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
